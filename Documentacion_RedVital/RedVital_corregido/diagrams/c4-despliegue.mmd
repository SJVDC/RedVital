  classDef tools fill:#6a00ff,stroke:#4400a8,color:#ffffff
  classDef gh fill:#1f6feb,stroke:#0b4aa8,color:#ffffff

  subgraph EXT["Actores y sistemas externos"]
    ADM(["Administrador<br/>(soporte)"]):::persona
    INET(["Internet<br/>Usuarios"]):::persona
    GH["GitHub · GitHub Actions<br/>Repositorios y pipeline"]:::gh
  end

  subgraph NUBE["Nube Javeriana"]
