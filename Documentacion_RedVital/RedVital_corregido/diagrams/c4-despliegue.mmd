      RUN["GitHub Actions Runner<br/>[self-hosted]"]:::tools
      PROM["Prometheus"]:::tools
      GRAF["Grafana"]:::tools
      KBT["Kafbat<br/>[inspección de Kafka]"]:::tools
      BKP["Utilidades de respaldo<br/>[scripts · pg_dump]"]:::tools
    end

  subgraph AENV["Ambiente QA"]
    subgraph AVMD["VM2 · Datos QA"]
      ADBID[("db_identidad")]:::identdb
      ADBCAMP[("db_campana")]:::campdb
      ADBDON[("db_donacion")]:::dondb
      ADBINST[("db_institucional")]:::instdb
    end
    subgraph AVMS["VM3 · Servicios QA"]
      AID{{"Servicio de Identidad<br/>[.NET 10]"}}:::ident
      ACAMP{{"Servicio de Campañas<br/>[.NET 10]"}}:::camp
      ADON{{"Servicio de Donación<br/>[Java 25 · Spring Boot]"}}:::don
