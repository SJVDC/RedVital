  classDef ident fill:#d6247b,stroke:#9b1a58,color:#ffffff
  classDef identdb fill:#e58ab8,stroke:#9b1a58,color:#000000
  classDef inst fill:#13955a,stroke:#0d6b40,color:#ffffff
  classDef instdb fill:#7fd1a8,stroke:#0d6b40,color:#000000
  classDef camp fill:#ff8000,stroke:#b35a00,color:#000000
  classDef campdb fill:#ffc27a,stroke:#b35a00,color:#000000
  classDef don fill:#00b5b5,stroke:#007f7f,color:#000000
  classDef dondb fill:#7fe0e0,stroke:#007f7f,color:#000000
  classDef notif fill:#ffd966,stroke:#bf9000,color:#000000
