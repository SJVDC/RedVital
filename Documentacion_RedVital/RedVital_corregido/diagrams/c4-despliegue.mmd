      AINST{{"Servicio Institucional<br/>[.NET 10 · prevista]<br/>pendiente"}}:::inst
      ANOT{{"Servicio de Notificaciones<br/>[Java 25 · prevista]<br/>pendiente"}}:::notif
    end
    subgraph AVMB["VM4 · Borde QA"]
      ACADDY["Caddy 2<br/>TLS · frontend web"]:::borde
      AAPISIX["Apache APISIX 3.19<br/>API Gateway"]:::borde
    end
  end
  INET -->|"HTTPS 443 (80 redirige)"| ACADDY
  ACADDY -->|"/api/*"| AAPISIX
  AAPISIX -->|"HTTP 8080 · 8082 · 8083<br/>según servicio"| AID
  AAPISIX --> ACAMP
  AAPISIX --> ADON
  AAPISIX -.-> AINST
  AID -->|"PostgreSQL TLS<br/>(puerto según composición)"| ADBID
  ACAMP --> ADBCAMP
  ADON --> ADBDON
