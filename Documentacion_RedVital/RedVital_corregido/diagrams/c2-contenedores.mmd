    INST{{"Servicio Institucional<br/>[.NET 10 · prevista]<br/>Instituciones, bancos de sangre y territorios<br/>(pendiente de implementación)"}}:::inst
    DBINST[("db_institucional<br/>[PostgreSQL 16]")]:::instdb

    NOT{{"Servicio de Notificaciones<br/>[Java 25 · prevista]<br/>Consume eventos y entrega notificaciones<br/>(pendiente · sin base de negocio)"}}:::notif

    KAFKA[["Apache Kafka 4.3.1<br/>[KRaft · SASL/SCRAM · ACL]<br/>Integración asíncrona entre servicios"]]:::kafka
