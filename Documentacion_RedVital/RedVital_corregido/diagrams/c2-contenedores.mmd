    CAMP{{"Servicio de Campañas<br/>[.NET 10]<br/>Campañas, publicación,<br/>cupos y reservas"}}:::camp
    DBCAMP[("db_campana<br/>[PostgreSQL 16]")]:::campdb

    DON{{"Servicio de Donación<br/>[Java 25 · Spring Boot]<br/>Donantes, donaciones, unidades, inventario,<br/>alertas, transferencias y trazabilidad"}}:::don
