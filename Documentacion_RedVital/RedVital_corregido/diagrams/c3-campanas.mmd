  GW["Apache APISIX<br/>[API Gateway]<br/>Enruta solicitudes, valida tokens<br/>y aplica control por ruta y rol"]:::borde
  K[["Apache Kafka 4.3.1"]]:::kafka

  subgraph SC["Servicio de Campañas [.NET 10]"]
    API["API de Campañas<br/>[ASP.NET Core]<br/>Consultar, publicar, cerrar y<br/>obtener el detalle de campañas"]:::camp
    GEST["Gestor de Campañas<br/>Coordina consulta, publicación, cierre<br/>y ciclo de vida de las campañas"]:::camp
    DET["Consulta de Detalle de Campaña<br/>Detalle de una campaña para<br/>usuarios autorizados (vía API)"]:::camp
    PUB["Control de Publicación y Cierre<br/>Valida y ejecuta las transiciones<br/>de publicación y cierre"]:::camp
    RES["Gestor de Cupos y Reservas (RF-15)<br/>Esquema disponible; sin operación<br/>expuesta en el incremento"]:::camp
    FIL["Filtro de Rol y Jurisdicción<br/>Filtra campañas según el rol<br/>y la jurisdicción del sujeto"]:::camp
    AUD["Registro de Auditoría de Campañas<br/>Publicación y cierre (append-only)"]:::camp
    REPO["Repositorio de Campañas<br/>[Entity Framework Core]<br/>Campañas, reservas y auditoría"]:::camp
    OUT["Publicador de Eventos<br/>[Kafka Producer · Outbox]<br/>Eventos de dominio de campañas"]:::camp
    CONS["Consumidor de Eventos<br/>[Kafka Consumer]<br/>Eventos relevantes para campañas"]:::camp
  end
  DB[("db_campana<br/>[PostgreSQL 16]")]:::campdb

  GW -->|"Invoca operaciones de campañas [HTTP/JSON]"| API
  API -->|"Delega operaciones"| GEST
  GEST -->|"Solicita información de campaña"| DET
  GEST -->|"Solicita transición de estado"| PUB
  GEST -.->|"Cupos y reservas"| RES
  GEST -->|"Valida alcance de acceso"| FIL
  GEST -->|"Lee y actualiza campañas"| REPO
  DET -->|"Consulta información"| REPO
  RES -.->|"Lee y actualiza reservas"| REPO
  FIL -->|"Consulta información para filtrado"| REPO
  PUB -->|"Registra publicación o cierre"| AUD
  PUB -->|"Registra evento en el Outbox<br/>(misma transacción)"| OUT
  AUD -->|"Persiste eventos de auditoría"| REPO
  REPO -->|"Lee y escribe [SQL]"| DB
  OUT -->|"Publica eventos de dominio [Kafka]"| K
  K -->|"Entrega eventos relevantes [Kafka]"| CONS
  CONS -->|"Solicita procesamiento del evento"| GEST
  style RES stroke-dasharray: 6 4,stroke-width:2px
