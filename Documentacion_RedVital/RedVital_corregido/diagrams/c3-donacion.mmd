  GW["Apache APISIX<br/>[API Gateway]<br/>Enruta solicitudes, valida tokens<br/>y aplica control por ruta y rol"]:::borde
  K[["Apache Kafka 4.3.1"]]:::kafka

  subgraph SD["Servicio de Donación [Java 25 · Spring Boot]"]
    API["API de Donación<br/>[Spring Boot]<br/>Registrar donaciones, existencias, tamizaje,<br/>despacho y disposición final"]:::don
    REG["Gestor de Registro de Donación<br/>Registra la donación y la unidad resultante;<br/>valida la campaña asociada"]:::don
    TAM["Gestor de Tamizaje<br/>Ingreso a tamizaje y veredicto<br/>apto / no apto (sin causa clínica)"]:::don
    INV["Gestor de Inventario<br/>Existencias por componente, tipo<br/>de sangre e institución autorizada"]:::don
    DES["Gestor de Despacho y Disposición<br/>Despacho y disposición final con<br/>las validaciones requeridas"]:::don
    PRO["Proyección de Campañas<br/>[modelo de lectura local]<br/>Campañas conocidas por Donación"]:::don
    CCO["Consumidor de Eventos de Campañas<br/>[Kafka Consumer]<br/>Mantiene la proyección"]:::don
    MOT["Motor de Transiciones<br/>Valida y ejecuta las transiciones<br/>del ciclo de vida de las unidades"]:::don
    VEN["Proceso de Vencimiento<br/>[programado · cada 5 min · UTC]<br/>Vence unidades (actor sistema)"]:::don
    ALE["Gestor de Alertas, Transferencias<br/>y Escalamiento (pendiente)"]:::don
    AUD["Registro de Auditoría de Donación<br/>Cambios de estado, despachos y<br/>disposición final (append-only)"]:::don
    REPO["Repositorio de Donación<br/>[Spring Data / Java]<br/>Donaciones, unidades, inventario,<br/>estados y auditoría"]:::don
    OUT["Outbox de Eventos<br/>Evento registrado en la misma<br/>transacción que el cambio"]:::don
    PUBL["Publicador de Eventos<br/>[Kafka Producer]<br/>Publica los eventos pendientes del Outbox"]:::don
  end
  DB[("db_donacion<br/>[PostgreSQL 16]")]:::dondb

